{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "可灵新版创建、查询、产物与错误响应契约",
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "decimal": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "video": {
      "type": "object",
      "required": ["type", "id", "url", "duration"],
      "properties": {
        "type": {"const": "video"},
        "id": {"$ref": "#/$defs/nonempty"},
        "url": {"$ref": "#/$defs/nonempty"},
        "watermark_url": {"type": "string"},
        "duration": {"$ref": "#/$defs/decimal"}
      }
    },
    "billing": {
      "type": "object",
      "required": ["charge_type", "amount"],
      "properties": {
        "charge_type": {"enum": ["cash", "unit"]},
        "amount": {"$ref": "#/$defs/decimal"},
        "cash_type": {"enum": ["balance", "test_balance", "reward_balance"]},
        "currency": {"enum": ["CNY", "USD"]},
        "package_type": {"enum": ["video", "image", "audio"]},
        "list_price": {"$ref": "#/$defs/decimal"}
      },
      "allOf": [
        {"if": {"properties": {"charge_type": {"const": "cash"}}},
         "then": {"required": ["cash_type", "currency", "list_price"]}},
        {"if": {"properties": {"charge_type": {"const": "unit"}}},
         "then": {"required": ["package_type"]}}
      ]
    },
    "task": {
      "type": "object",
      "required": ["id", "status", "create_time", "update_time"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["submitted", "processing", "succeeded", "failed"]},
        "message": {"type": "string"},
        "create_time": {"type": "integer", "minimum": 0},
        "update_time": {"type": "integer", "minimum": 0},
        "external_id": {"type": "string"},
        "outputs": {
          "type": "array",
          "items": {"type": "object", "required": ["type"], "properties": {
            "type": {"enum": ["video", "image", "audio", "element", "voice"]}
          }}
        },
        "usage": {"type": "object", "properties": {
          "input_duration": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}
        }},
        "billing": {"type": "array", "items": {"$ref": "#/$defs/billing"}}
      }
    },
    "envelope": {
      "type": "object",
      "required": ["code", "message", "request_id", "data"],
      "properties": {
        "code": {"const": 0},
        "message": {"type": "string"},
        "request_id": {"$ref": "#/$defs/nonempty"}
      }
    },
    "create": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {"properties": {"data": {"$ref": "#/$defs/task"}}}
      ]
    },
    "query": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {"properties": {"data": {"type": "array", "items": {"$ref": "#/$defs/task"}}}}
      ]
    },
    "succeeded_task": {
      "allOf": [
        {"$ref": "#/$defs/task"},
        {
          "required": ["outputs"],
          "properties": {
            "status": {"const": "succeeded"},
            "outputs": {
              "type": "array",
              "contains": {"$ref": "#/$defs/video"},
              "minContains": 1
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": {"type": "integer", "not": {"const": 0}},
        "message": {"$ref": "#/$defs/nonempty"},
        "request_id": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
