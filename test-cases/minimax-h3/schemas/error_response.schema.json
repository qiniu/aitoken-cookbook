{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "minimax-h3/error_response.schema.json",
  "title": "MiniMax H3 OpenAI 风格错误响应",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "http_code": {
          "type": "string",
          "pattern": "^[1-5][0-9]{2}$"
        }
      }
    },
    "request_id": {
      "type": "string"
    }
  }
}
